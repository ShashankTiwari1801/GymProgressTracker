<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/black"
    android:layout_height="match_parent">
    <GridLayout
        android:layout_width="match_parent"
        android:rowCount="3"
        android:columnCount="3"
        android:id="@+id/GL_CARD"
        android:layout_height="100sp">
        <TextView
            android:layout_row="0"
            android:layout_column="0"
            android:text="100"
            android:textStyle="bold"
            android:textColor="#767676"
            android:id="@+id/TV_CARD_DATE"
            android:paddingHorizontal="50sp"
            android:layout_columnSpan="1"
            android:layout_columnWeight="1"
            />
<!--
        <TextView
            android:layout_row="1"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:text="Morning"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_columnWeight="10"/>
            -->
        <TextView
            android:layout_row="2"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:text="0 Kg"
            android:id="@+id/TV_WEIGHT_MORNING"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_columnWeight="8"/>
        <TextView
            android:layout_row="1"
            android:layout_rowSpan="2"
            android:id="@+id/TV_WEIGHT_CARD_REMOVE"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="2sp"
            android:background="@color/red_grad"
            android:layout_column="2"/>
    </GridLayout>
</LinearLayout>